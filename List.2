=====Remove Duplicate Numbers=====

repeat = [1, 2, 3, 2, 4, 1, 5]
print("Original list:",repeat)
duplicate = []
for x in repeat:
    if x not in duplicate:
        duplicate.append(x)
print("Unique list:",duplicate)


