====Student Attendence List====

attendence=[1,0,1,1,1,0]
print("Student Attendence:", attendence) 
present=attendence.count(1)
absent=attendence.count(0)
percentage=(present/6)*100
print("Student Present Attendence:", present)
print("Student Absent Attendence:", absent)
print("Percentage Of Present Student:",percentage)



