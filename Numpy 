=====Shapes And Reshaping=====

import numpy as np
x=np.arange(12).reshape(3,4)
print(x.shape)
print(x.reshape(4,3))
print(x.flatten())
print(x.T)


====Slicing And Indexing=====

import numpy as np
x=np.arange(20).reshape(4,5)
print(x)
print(x[1,:])
print(x[:,2])
print(x[1:3,1:3])
print(x[x>10])


=====Broadcasting=====

import numpy as np
a=np.array([[1,2,3],[4,5,6]])
b=np.array([10,20,30])
print(a+b)
print(a-b)
print(a*b)
print(a/b)



=====Aggregation And Axis=====

import numpy as np
x=np.arange(12).reshape(3,4)
print(x)
print(x.sum)
print(x.sum(axis=0))
print(x.sum(axis=1))
print(x.mean(axis=0))
