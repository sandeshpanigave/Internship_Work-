===Employee Payroll Calculator===

def gross_salary(salary,hra,da):
    return salary+hra+da
def deduction(pt,tax):
    return pt+tax
def net_salary(gross,deduction):
    return gross-deduction

salary=int(input("Enter Basic salary:"))
hra=int(input("Enter HRA:"))
da=int(input("Enter DA:"))
pf=int(input("Enter PF:"))
tax=int(input("Enter Tax:"))
gross=gross_salary(salary,hra,da)
dead=deduction(pf,tax)
net=net_salary(gross,dead)
print("Gross salary:",gross)
print("Deduction:",dead)
print("Net salary:",net)


===Bank Account Management System===

balance = 0
history = ""

def create_account():
    global balance,history
    name=input("Enter Name:")
    balance = int(input("EnterBalance:"))
    history = "Account Created"

def deposit():
    global balance,history
    amount = int(input("Enter Deposit Amount: "))
    if amount > 0:
        balance += amount
        history += str(amount) 
    else:
        print("Invalid Amount")

def withdraw():
    global balance,history
    amount = int(input("Enter Withdrawal Amount: "))
    if amount <= balance:
        balance -= amount
        history += str(amount) 
    else:
        print("Insufficient Balance")

def get_balance():
    print("Balance:", balance)

def show_transaction_history():
    print(history)

create_account()
deposit()
withdraw()
get_balance()
show_transaction_history()



===E-commerce billing system===

def calculate_total(price,quantity):
    return price*quantity

def calculate_discount(total):
    discount=total* 0.1
    return discount

def calculate_gst(amount):
    gst=amount*0.18
    return gst

def calculate_shipping(amount):
    if amount>=500:
        return 0
    return 50

def generate_invoice():
    price=float(input("Enter price: "))
    quantity=int(input("Enter quantity: "))

    total=calculate_total(price,quantity)
    discount=calculate_discount(total)
    amount=total-discount
    gst=calculate_gst(amount)
    shipping=calculate_shipping(amount)

    final=amount+gst+shipping

    print("\n--- INVOICE ---")
    print("Item Total:",total)
    print("Discount:",discount)
    print("After Discount:",amount)
    print("GST:",gst)
    print("Shipping:",shipping)
    print("Final Amount:",final)
generate_invoice()


