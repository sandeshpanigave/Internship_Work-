def ask_question(question,correct_answer,option=None):
    print(question)
    if option:
        for opt in option:
            print(opt)
    answer=input("your answer:").strip().lower()
    if answer==correct_answer.lower():
        print("Correct!\n")
        return True
    else:
        print(f"wrong!the correct answer was:{correct_answer}\n")
        return False    
