balance = 0
history = ""

def create_account():
    global balance,history
    name=input("Enter Name:")
    balance = int(input("EnterBalance:"))
    history = "Account Created"

def deposit():
    global balance,history
    amount = int(input("Enter Deposit Amount: "))
    if amount > 0:
        balance += amount
        history += str(amount) 
    else:
        print("Invalid Amount")

def withdraw():
    global balance,history
    amount = int(input("Enter Withdrawal Amount: "))
    if amount <= balance:
        balance -= amount
        history += str(amount) 
    else:
        print("Insufficient Balance")

def get_balance():
    print("Balance:", balance)

def show_transaction_history():
    print(history)

create_account()
deposit()
withdraw()
get_balance()
show_transaction_history()